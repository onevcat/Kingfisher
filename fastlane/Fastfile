fastlane_version "1.37.0"

require_relative "simulator_destination"

default_platform :ios

platform :ios do
  def derived_data_path(destination)
    return File.expand_path(ENV["DERIVED_DATA_PATH"], Dir.pwd) unless ENV["DERIVED_DATA_PATH"].to_s.empty?

    run_id = ENV["GITHUB_RUN_ID"] || "local"
    xcode = ENV["XCODE_VERSION"] || "default-xcode"
    destination_key = destination.to_s.gsub(/[^A-Za-z0-9_.-]/, "_")
    File.expand_path("../build/DerivedData/#{run_id}-#{xcode}-#{destination_key}", __dir__)
  end

  # Replaces a simulator destination with an available device. See `SimulatorDestination` for why and how.
  def resolve_destination(destination)
    return destination unless destination.to_s.include?(" Simulator")

    devices =JSON.parse(sh("xcrun simctl list devices available --json", log: false))["devices"]
    resolution = SimulatorDestination.resolve(destination, devices)
    return destination if resolution.nil?

    description = "#{resolution.device_name} (#{resolution.os}), #{resolution.destination}"
    if resolution.exact
      UI.message("Destination '#{destination}' resolved to #{description}.")
    else
      UI.important("Destination '#{destination}' is not available. Using #{description} instead.")
    end
    resolution.destination
  end

  # Boots a resolved simulator destination and waits until it finishes booting, so a slow boot is not counted
  # against launching the test runner.
  def boot_simulator(destination)
    udid = destination.to_s[/(?:^|,)id=([^,]+)/, 1]
    return if udid.nil?

    # `simctl boot` fails when the simulator is already booted, which is fine.
    sh("xcrun", "simctl", "boot", udid, log: false, error_callback: ->(_) {})
    sh("xcrun", "simctl", "bootstatus", udid, "-b")
  end

  def shutdown_simulator(destination)
    udid = destination.to_s[/(?:^|,)id=([^,]+)/, 1]
    return if udid.nil?

    sh("xcrun", "simctl", "shutdown", udid, log: false, error_callback: ->(_) {})
  end

  # Runs the block while watching for a test runner left suspended on the simulator. `xcodebuild` launches `xctest`
  # suspended and expects DTServiceHub to resume it. When that hand-off fails ("failed to bless service hub"), the
  # runner stays stopped until the run fails with "The test runner hung before establishing connection". A runner
  # that has been stopped for longer than `grace` seconds is resumed with SIGCONT, which lets the tests run.
  def with_suspended_runner_watchdog(destination, grace: 60, interval: 5)
    udid = destination.to_s[/(?:^|,)id=([^,]+)/, 1]
    return yield if udid.nil?

    finished = false
    watchdog = Thread.new do
      stopped_since = {}
      until finished
        sleep interval
        now = Time.now
        pids = suspended_runner_pids(udid)
        stopped_since.select! { |pid, _| pids.include?(pid) }
        pids.each do |pid|
          stopped_since[pid] ||= now
          next if now - stopped_since[pid] < grace

          UI.important("Test runner #{pid} stayed suspended for #{grace}s. Resuming it with SIGCONT.")
          Process.kill("CONT", pid) rescue nil
          stopped_since.delete(pid)
        end
      end
    end

    begin
      yield
    ensure
      finished = true
      watchdog.join(interval + 5)
    end
  end

  # Process IDs of stopped `xctest` processes started by the `launchd_sim` of the simulator with `udid`.
  def suspended_runner_pids(udid)
    processes = `ps -axo pid=,ppid=,stat=,command=`.lines.map do |line|
      pid, ppid, stat, command = line.strip.split(/\s+/, 4)
      { pid: pid.to_i, ppid: ppid.to_i, stat: stat.to_s, command: command.to_s }
    end
    launchd_pids = processes
      .select { |p| p[:command].start_with?("launchd_sim ") && p[:command].include?(udid) }
      .map { |p| p[:pid] }
    processes
      .select { |p| launchd_pids.include?(p[:ppid]) && p[:stat].start_with?("T") }
      .select { |p| File.basename(p[:command].split(" ").first.to_s) == "xctest" }
      .map { |p| p[:pid] }
  end

  # Whether a `scan` run that started at `started_at` failed because the test runner never started, rather than
  # because of a test. `xcodebuild` writes this error to stderr, which does not reach the scan build log, so read
  # the result bundle instead.
  def test_runner_failed_to_start?(derived_data_path, started_at)
    results = Dir.glob(File.join(derived_data_path, "Logs", "Test", "*.xcresult"))
      .select { |path| File.mtime(path) >= started_at }
    results.any? do |path|
      output = sh("xcrun", "xcresulttool", "get", "test-results", "summary", "--path", path,
                  log: false, error_callback: ->(_) {})
      summary = JSON.parse(output.to_s.dup.force_encoding(Encoding::UTF_8)) rescue nil
      next false if summary.nil? || summary["passedTests"].to_i > 0

      (summary["testFailures"] || []).any? do |failure|
        failure["failureText"].to_s.include?("The test runner hung before establishing connection")
      end
    end
  end

  desc "Runs all the tests"
  lane :tests do
    test(destination: "platform=macOS")
    test(destination: "platform=iOS Simulator,name=iPhone 18 Pro,OS=27.0")
    test(destination: "platform=tvOS Simulator,name=Apple TV 4K (3rd generation),OS=27.0")
    test(destination: "platform=visionOS Simulator,name=Apple Vision Pro,OS=27.0")
    build(destination: "platform=watchOS Simulator,name=Apple Watch Series 12 (42mm),OS=27.0")
  end

  lane :test_ci do
    if !ENV["SDK"].to_s.empty?
        build(sdk: ENV["SDK"])
    elsif ENV["DESTINATION"].include? "watchOS" then
        build(destination: ENV["DESTINATION"])
    else
        test(destination: ENV["DESTINATION"])
    end
  end

  lane :build_ci do
    if ENV["SDK"].to_s.empty?
      build(destination: ENV["DESTINATION"])
    else
      build(sdk: ENV["SDK"])
    end
  end

  lane :test do |options|
    destination = resolve_destination(options[:destination])
    derived_data = derived_data_path(options[:destination])
    attempts = 0

    begin
      attempts += 1
      started_at = Time.now - 1
      boot_simulator(destination)
      with_suspended_runner_watchdog(destination) do
        scan(
          scheme: "Kingfisher",
          clean: true,
          derived_data_path: derived_data,
          xcargs: "SWIFT_VERSION=5.0",
          destination: destination,
          # CI runner VMs occasionally stall for tens of seconds, blowing async
          # expectation budgets. Retry failed tests instead of inflating timeouts;
          # a real regression still fails all attempts.
          number_of_retries: 2
        )
      end
    rescue => error
      # A test runner that never connects runs no test at all, so starting over on a fresh boot is safe. Test
      # failures are not retried here; `number_of_retries` already covers them.
      raise error unless attempts < 2 && test_runner_failed_to_start?(derived_data, started_at)

      UI.important("The test runner did not start. Rebooting the simulator and running the tests again.")
      shutdown_simulator(destination)
      retry
    end
  end

  lane :build do |options|
    build_options = {
      workspace: "Kingfisher.xcworkspace",
      configuration: "Debug",
      scheme: "Kingfisher",
      derivedDataPath: derived_data_path(options[:destination] || options[:sdk]),
      clean: true,
      build: true,
      build_settings: {
        "SWIFT_VERSION" => "5.0"
      }
    }

    if options[:sdk].to_s.empty?
      build_options[:destination] = resolve_destination(options[:destination])
    else
      build_options[:sdk] = options[:sdk]
    end

    xcodebuild(build_options)
  end

  desc "Lint"
  lane :lint do
    spm
  end

  desc "Release new version"
  lane :release do |options|
    target_version = options[:version]
    raise "The version is missed. Use `fastlane release version:{version_number}`.`" if target_version.nil?

    ensure_git_branch
    ensure_git_status_clean

    skip_tests =  options[:skip_tests]
    tests unless skip_tests

    lint

    sync_build_number_to_git
    increment_version_number(version_number: target_version)

    log = extract_current_change_log(version: target_version)
    release_log = update_change_log(log: log)

    git_commit_all(message: "Bump version to #{target_version}")

    Actions.sh("git tag -s #{target_version} -m ''")

    push_to_git_remote

    xcframework(version: target_version)
    set_github_release(
      repository_name: "onevcat/Kingfisher",
      api_token: ENV['GITHUB_TOKEN'],
      name: release_log[:title],
      tag_name: target_version,
      description: release_log[:text],
      upload_assets: [
        "build/Kingfisher-#{target_version}.xcframework.zip",
        "build/Kingfisher-iOS-#{target_version}.xcframework.zip"
      ]
    )
  end

  lane :xcframework do |options|
    version = options[:version]
    swift_version = options[:swift_version] || "5.0"
    xcode_version = options[:xcode_version] || "27.2"

    xcodes(version: xcode_version, select_for_current_build_only: true)
    FileUtils.rm_rf '../build'

    # Define platform to SDKs mapping
    PLATFORM_SDKS = {
      all: [
        "macosx",
        "iphoneos", "iphonesimulator",
        "appletvos", "appletvsimulator",
        "watchos", "watchsimulator",
        "xros", "xrsimulator"
      ],
      ios: ["iphoneos", "iphonesimulator"]
    }

    def create_archives(sdks, swift_version)
      frameworks = {}
      sdks.each do |sdk|
        archive_path = "build/Kingfisher-#{sdk}.xcarchive"
        xcodebuild(
          archive: true,
          archive_path: archive_path,
          scheme: "Kingfisher",
          sdk: sdk,
          build_settings: {
            "BUILD_LIBRARY_FOR_DISTRIBUTION" => "YES",
            "SKIP_INSTALL" => "NO",
            "SWIFT_VERSION" => swift_version
          }
        )

        framework_path = "#{archive_path}/Products/Library/Frameworks/Kingfisher.framework"
        dsym_path = "#{Dir.pwd}/../#{archive_path}/dSYMs/Kingfisher.framework.dSYM"
        frameworks[framework_path] = { dsyms: dsym_path }
      end
      frameworks
    end

    def create_and_package_xcframework(frameworks, output_name, version)
      output_base_name = if output_name.empty?
        "Kingfisher-#{version}"
      else
        "Kingfisher-#{output_name}-#{version}"
      end

      output_xcframework_path = "build/#{output_base_name}/Kingfisher.xcframework"

      create_xcframework(
        frameworks_with_dsyms: frameworks,
        output: output_xcframework_path
      )

      Actions.sh("codesign --timestamp -v --sign 'Apple Distribution: Wei Wang (A4YJ9MRZ66)' ../build/#{output_base_name}/Kingfisher.xcframework")

      zip(
        path: output_xcframework_path,
        output_path: "build/#{output_base_name}.xcframework.zip",
        symlinks: true
      )
    end

    # Create full platform xcframework
    all_frameworks = create_archives(PLATFORM_SDKS[:all], swift_version)
    create_and_package_xcframework(all_frameworks, "", version)

    # Create iOS only xcframework
    ios_frameworks = create_archives(PLATFORM_SDKS[:ios], swift_version)
    create_and_package_xcframework(ios_frameworks, "iOS", version)
  end

  before_all do |lane|
    xcode_version = ENV["XCODE_VERSION"] || "27.2"
    xcodes(version: xcode_version, select_for_current_build_only: true)
  end

  after_all do |lane|

  end

  error do |lane, exception|

  end
end
